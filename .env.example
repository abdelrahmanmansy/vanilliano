# Supabase – لوحة التحكم
# انسخ هذا الملف إلى .env واملأ القيم من إعدادات مشروعك في Supabase
# (Project Settings -> API) ثم فعّل option: Use Session Cookie? لا.

# رابط مشروعك، مثال: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=

# المفتاح العام للزوار (anon key) - آمن للنشر العام
VITE_SUPABASE_ANON_KEY=

# كلمة سر صاحب المشروع للدخول للوحة التحكم فقط
# (حساب حقيقي من Supabase Auth - لا ينشر في المتصفح)